{
	"author": "d2tx",
	"name": "Gruvbox Steam",
	"description": "Gruvbox-themed Windows 95 look for Steam",
	"version": "1.0.0",
	"header_image": "https://raw.githubusercontent.com/d2tx/gruvbox-steam/main/assets/preview/steam/main-window.png",
	"splash_image": "https://raw.githubusercontent.com/d2tx/gruvbox-steam/main/assets/preview/steam/main-window.png",
	"github": {
		"owner": "d2tx",
		"repo_name": "gruvbox-steam"
	},
	"Patches": [
		{
			"MatchRegexString": ".DesktopUI",
			"TargetCss": "steam_import.css",
			"TargetJs": "src/steam/steam.js"
		},
		{
			"MatchRegexString": ".fullheight",
			"TargetCss": "steam_import.css",
			"TargetJs": "src/steam/steam.js"
		},
		{
			"MatchRegexString": ".friendsui-container",
			"TargetCss": "steam_import.css",
			"TargetJs": "src/steam/steam.js"
		}
	],
	"Conditions": {
		"Colors": {
			"description": "",
			"default": "Gruvbox",
			"values": {
				"Gruvbox": {
					"TargetCss": {
						"affects": [".*"],
						"src": "src/shared/colors/gruvbox.css"
					}
				}
			}
		},
		"Reduced game list entry height": {
			"default": "no",
			"description": "Makes the game list entries' height smaller.\nOnly use this if you patched Steam! Run [c]./scripts/patch steam[/c] in the repo's directory to apply the patches (Linux only).",
			"values": {
				"yes": {
					"TargetCss": {
						"affects": [".*"],
						"src": "src/steam/options/reduceditemheight.css"
					}
				}
			}
		}
	}
}
